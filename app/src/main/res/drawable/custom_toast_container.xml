<!--Content frame container for each custom toast item to provide color,shape and padding to the custom toast items-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!--background color-->
    <solid android:color="@color/grey"/>
    <!--to add rounded corners-->
    <corners android:radius="40dp"/>
    <!--for padding-->
    <padding android:bottom="0dp" android:left="10dp" android:right="10dp" android:top="0dp"/>
</shape>